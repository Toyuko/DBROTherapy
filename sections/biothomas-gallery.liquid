<section class="biothomas-section" id="BiothomasGallery-{{ section.id }}">
  <div class="biothomas-section__inner">
    <div class="biothomas-section__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="biothomas-section__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="biothomas-section__subheading">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>

    <div class="biothomas-gallery">
      {%- for block in section.blocks -%}
        <figure class="biothomas-gallery__item" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 1000
              | image_tag:
                loading: 'lazy',
                widths: '400, 600, 800, 1000',
                sizes: '(min-width: 750px) 30vw, 50vw',
                alt: block.settings.image.alt | default: block.settings.caption | default: 'BIOTHOMAS gallery image'
            }}
          {%- elsif block.settings.image_asset != blank -%}
            <img
              src="{{ block.settings.image_asset | asset_url }}"
              alt="{{ block.settings.caption | default: 'BIOTHOMAS gallery image' | escape }}"
              loading="lazy"
              width="1000"
              height="1000"
            >
          {%- else -%}
            <span style="display:grid;place-items:center;height:100%;color:#666;font-size:1.3rem;padding:1rem;text-align:center;">
              {{ block.settings.caption | default: 'Gallery placeholder' | escape }}
            </span>
          {%- endif -%}
          {%- if block.settings.caption != blank -%}
            <figcaption class="visually-hidden">{{ block.settings.caption | escape }}</figcaption>
          {%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "BIOTHOMAS Gallery",
  "tag": "section",
  "class": "section-biothomas-gallery",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Gallery"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Product photography and real-world use across personal, athletic, and professional setups."
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Theme asset filename",
          "info": "Fallback when no Image is selected (e.g. gallery-01-night-use.jpg)."
        },
        { "type": "text", "id": "caption", "label": "Caption", "default": "BIOTHOMAS system" }
      ]
    }
  ],
  "presets": [
    {
      "name": "BIOTHOMAS Gallery",
      "blocks": [
        {
          "type": "image",
          "settings": {
            "image_asset": "gallery-01-night-use.jpg",
            "caption": "Silent night use"
          }
        },
        {
          "type": "image",
          "settings": {
            "image_asset": "gallery-02-household.jpg",
            "caption": "Household molecular hydrogen"
          }
        },
        {
          "type": "image",
          "settings": {
            "image_asset": "gallery-03-professional.jpg",
            "caption": "Professional floor system"
          }
        },
        {
          "type": "image",
          "settings": {
            "image_asset": "gallery-04-athletic.jpg",
            "caption": "Athletic recovery session"
          }
        },
        {
          "type": "image",
          "settings": {
            "image_asset": "gallery-05-dimensions.jpg",
            "caption": "Hydro-Max dimensions"
          }
        },
        {
          "type": "image",
          "settings": {
            "image_asset": "gallery-06-touch-panel.jpg",
            "caption": "Touch panel controls"
          }
        }
      ]
    }
  ]
}
{% endschema %}
