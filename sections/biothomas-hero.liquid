{% comment %} BIOThomas full-bleed hero — Theme Editor configurable {% endcomment %}

<section
  id="BiothomasHero-{{ section.id }}"
  class="biothomas-hero"
  aria-label="{{ section.settings.heading | escape }}"
>
  <div class="biothomas-hero__media">
    {%- if section.settings.video != blank -%}
      {{
        section.settings.video
        | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          playsinline: true,
          image_size: '2000x'
      }}
    {%- elsif section.settings.image != blank -%}
      {%- assign hero_alt = section.settings.image.alt | default: section.settings.heading -%}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          widths: '750, 1100, 1500, 1780, 2000, 2400',
          sizes: '100vw',
          alt: hero_alt,
          fetchpriority: 'high',
          loading: 'eager'
      }}
    {%- endif -%}
  </div>
  <div class="biothomas-hero__overlay" aria-hidden="true"></div>

  <div class="biothomas-hero__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="biothomas-hero__eyebrow bt-animate-fade-up">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="biothomas-hero__heading bt-animate-fade-up-delay">{{ section.settings.heading | escape }}</h1>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <p class="biothomas-hero__text bt-animate-fade-up-delay-2">{{ section.settings.text | escape }}</p>
    {%- endif -%}

    <div class="biothomas-hero__actions bt-animate-fade-up-delay-2">
      {%- if section.settings.button_label_1 != blank -%}
        <a
          class="button"
          {% if section.settings.button_link_1 == blank %}
            role="link" aria-disabled="true"
          {% else %}
            href="{{ section.settings.button_link_1 }}"
          {% endif %}
        >
          {{ section.settings.button_label_1 | escape }}
        </a>
      {%- endif -%}
      {%- if section.settings.button_label_2 != blank -%}
        <a
          class="button button--secondary"
          {% if section.settings.button_link_2 == blank %}
            role="link" aria-disabled="true"
          {% else %}
            href="{{ section.settings.button_link_2 }}"
          {% endif %}
        >
          {{ section.settings.button_label_2 | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "BIOThomas Hero",
  "tag": "section",
  "class": "section-biothomas-hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "BIOThomas"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Advanced Molecular Hydrogen & Oxyhydrogen Systems"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Supporting text",
      "default": "Find Your Path. Heal. Grow. — clinical-grade H₂ and Brown's Gas therapy for daily wellness, athletic recovery, and professional care."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "info": "TODO: Replace with owned BIOThomas hero imagery"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Background video",
      "info": "Optional. Uploaded Shopify video preferred over external stock."
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "Primary button label",
      "default": "Browse Systems"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Secondary button label",
      "default": "Watch Clinical Demo"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary button link"
    }
  ],
  "presets": [
    {
      "name": "BIOThomas Hero"
    }
  ]
}
{% endschema %}
