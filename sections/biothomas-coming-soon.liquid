{% comment %} BIOThomas coming soon — password / pre-launch landing {% endcomment %}

{{ 'biothomas-coming-soon.css' | asset_url | stylesheet_tag }}

<section class="bt-coming-soon" aria-label="{{ section.settings.heading | default: 'Coming soon' | escape }}">
  <div class="bt-coming-soon__grid" aria-hidden="true"></div>
  <div class="bt-coming-soon__orb bt-coming-soon__orb--1" aria-hidden="true"></div>
  <div class="bt-coming-soon__orb bt-coming-soon__orb--2" aria-hidden="true"></div>

  <div class="bt-coming-soon__bubbles" aria-hidden="true">
    {%- for i in (1..12) -%}
      <span
        class="bt-coming-soon__bubble"
        style="
          left: {{ i | times: 7 | plus: 3 }}%;
          width: {{ i | modulo: 4 | times: 0.6 | plus: 0.8 }}rem;
          height: {{ i | modulo: 4 | times: 0.6 | plus: 0.8 }}rem;
          animation-duration: {{ i | modulo: 5 | times: 2 | plus: 10 }}s;
          animation-delay: {{ i | times: 0.7 }}s;
        "
      ></span>
    {%- endfor -%}
  </div>

  <div class="bt-coming-soon__top">
    <password-modal>
      <details class="password-modal modal">
        <summary class="modal__toggle" aria-haspopup="dialog">
          <div class="modal__toggle-open bt-coming-soon__enter">
            <span class="svg-wrapper">
              {{- 'icon-padlock.svg' | inline_asset_content -}}
            </span>
            {{ 'general.password_page.login_password_button' | t }}
          </div>
          <div class="modal__toggle-close" aria-hidden="true">
            <span class="svg-wrapper">
              {{- 'icon-close.svg' | inline_asset_content -}}
            </span>
          </div>
        </summary>
        <div
          class="modal__content"
          role="dialog"
          aria-labelledby="BiothomasComingSoonPasswordHeading"
          aria-modal="true"
        >
          <div class="password-modal__content" tabindex="-1">
            <button type="button" class="modal__close-button link" aria-label="{{ 'accessibility.close' | t }}">
              <span class="svg-wrapper">
                {{- 'icon-close.svg' | inline_asset_content -}}
              </span>
            </button>
            <h2 class="password-modal__content-heading" id="BiothomasComingSoonPasswordHeading">
              {{ 'general.password_page.login_form_heading' | t }}
            </h2>
            {%- form 'storefront_password', class: 'password-form' -%}
              <div class="password-field field{% if form.errors %} password-field--error{% endif %}">
                <input
                  type="password"
                  name="password"
                  id="BiothomasComingSoonPassword"
                  class="field__input"
                  autocomplete="current-password"
                  {% if form.errors %}
                    aria-invalid="true"
                    aria-describedby="BiothomasComingSoonPassword-error"
                  {% endif %}
                  placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}"
                >
                <label class="field__label" for="BiothomasComingSoonPassword">
                  {{ 'general.password_page.login_form_password_label' | t }}
                </label>
                {%- if form.errors -%}
                  <div id="BiothomasComingSoonPassword-error" role="status">
                    <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
                    <span class="form__message">
                      <span class="svg-wrapper">
                        {{- 'icon-error.svg' | inline_asset_content -}}
                      </span>
                      {{ 'general.password_page.login_form_error' | t }}
                    </span>
                  </div>
                {%- endif -%}
              </div>
              <button name="commit" class="password-button button button--outline">
                {{ 'general.password_page.login_form_submit' | t }}
              </button>
            {%- endform -%}
            <small class="password__footer-text">{{ 'general.password_page.admin_link_html' | t }}</small>
          </div>
        </div>
      </details>
    </password-modal>
  </div>

  <div class="bt-coming-soon__main">
    <div class="bt-coming-soon__content">
      <img
        class="bt-coming-soon__logo"
        src="{{ 'biothomas-logo.png' | asset_url }}"
        alt="{{ section.settings.logo_alt | default: shop.name | escape }}"
        width="1024"
        height="196"
        loading="eager"
        fetchpriority="high"
      >

      {%- if section.settings.status_label != blank -%}
        <p class="bt-coming-soon__status">{{ section.settings.status_label | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="bt-coming-soon__heading">{{ section.settings.heading | escape }}</h1>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <p class="bt-coming-soon__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}

      {%- if section.settings.show_email_signup -%}
        <div class="bt-coming-soon__form">
          {% form 'customer', class: 'bt-coming-soon-newsletter' %}
            <input type="hidden" name="contact[tags]" value="newsletter, coming-soon">
            <div class="bt-coming-soon__form-row">
              <div class="bt-coming-soon__field">
                <label class="visually-hidden" for="BiothomasComingSoonEmail-{{ section.id }}">
                  {{ 'newsletter.label' | t }}
                </label>
                <input
                  id="BiothomasComingSoonEmail-{{ section.id }}"
                  class="bt-coming-soon__input"
                  type="email"
                  name="contact[email]"
                  value="{{ form.email }}"
                  aria-required="true"
                  autocorrect="off"
                  autocapitalize="off"
                  autocomplete="email"
                  placeholder="{{ section.settings.email_placeholder | escape }}"
                  required
                  {% if form.errors %}
                    aria-invalid="true"
                    aria-describedby="BiothomasComingSoonEmail-error-{{ section.id }}"
                  {% endif %}
                >
              </div>
              <button type="submit" class="bt-coming-soon__submit" name="commit">
                {{ section.settings.button_label | escape }}
              </button>
            </div>

            {%- if form.posted_successfully? -%}
              <p class="bt-coming-soon__message bt-coming-soon__message--success" role="status">
                {{ section.settings.success_message | escape }}
              </p>
            {%- elsif form.errors -%}
              <p
                id="BiothomasComingSoonEmail-error-{{ section.id }}"
                class="bt-coming-soon__message bt-coming-soon__message--error"
                role="alert"
              >
                {{ form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email }}
              </p>
            {%- endif -%}
          {% endform %}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.footer_note != blank -%}
    <p class="bt-coming-soon__footer">{{ section.settings.footer_note }}</p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "BIOThomas Coming Soon",
  "tag": "div",
  "class": "section-biothomas-coming-soon",
  "settings": [
    {
      "type": "text",
      "id": "logo_alt",
      "label": "Logo alt text",
      "default": "BIOThomas"
    },
    {
      "type": "text",
      "id": "status_label",
      "label": "Status label",
      "default": "Coming soon"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find Your Path. Build. Grow."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Supporting text",
      "default": "Advanced molecular hydrogen and oxyhydrogen systems engineered for daily use, athletic use, and professional environments."
    },
    {
      "type": "checkbox",
      "id": "show_email_signup",
      "label": "Show email signup",
      "default": true
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Notify me"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thank you — we’ll notify you at launch."
    },
    {
      "type": "inline_richtext",
      "id": "footer_note",
      "label": "Footer note",
      "default": "BIOThomas · Molecular hydrogen systems"
    }
  ],
  "presets": [
    {
      "name": "BIOThomas Coming Soon"
    }
  ]
}
{% endschema %}
