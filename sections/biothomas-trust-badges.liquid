<section class="biothomas-trust" aria-label="{{ section.settings.heading | default: 'Trust signals' | escape }}">
  {%- if section.settings.heading != blank -%}
    <h2 class="visually-hidden">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  <div class="biothomas-trust__grid">
    {%- for block in section.blocks -%}
      <div class="biothomas-trust__item" {{ block.shopify_attributes }}>
        <p class="biothomas-trust__value">{{ block.settings.value | escape }}</p>
        <p class="biothomas-trust__label">{{ block.settings.label | escape }}</p>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "BIOTHOMAS Trust Badges",
  "tag": "section",
  "class": "section-biothomas-trust",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Accessible heading",
      "default": "Why BIOTHOMAS"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "99.99%"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Pure H₂ Output"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "BIOTHOMAS Trust Badges",
      "blocks": [
        { "type": "badge", "settings": { "value": "3000 ml/min", "label": "Peak Flow Capacity" } },
        { "type": "badge", "settings": { "value": "99.99%", "label": "Pure H₂ Output" } },
        { "type": "badge", "settings": { "value": "1-Year", "label": "Warranty Included" } },
        { "type": "badge", "settings": { "value": "Free", "label": "Global Shipping" } }
      ]
    }
  ]
}
{% endschema %}
