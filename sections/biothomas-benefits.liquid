        { "type": "text", "id": "point_2", "label": "Point 2", "default": "Gentle daily inhalation protocols" },
        { "type": "text", "id": "point_3", "label": "Point 3", "default": "Ideal paired with H₂-Lite travel use" },
        { "type": "text", "id": "caption", "label": "Visual caption", "default": "Cellular energy from the inside out" },
        { "type": "image_picker", "id": "image", "label": "Image" }
      ]
    }
  ],
  "presets": [
    {
