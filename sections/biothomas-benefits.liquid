<section class="biothomas-section" id="BiothomasBenefits-{{ section.id }}" data-bt-benefits style="background: #fff;">
  <div class="biothomas-section__inner">
    <div class="biothomas-section__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="biothomas-section__heading" id="BenefitsHeading-{{ section.id }}">
          {{ section.settings.heading | escape }}
        </h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="biothomas-section__subheading">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>

    <div class="biothomas-benefits__tabs" role="tablist" aria-labelledby="BenefitsHeading-{{ section.id }}">
      {%- for block in section.blocks -%}
        <button
          type="button"
          class="biothomas-benefits__tab"
          role="tab"
          id="BenefitTab-{{ section.id }}-{{ block.id }}"
          data-bt-benefit-tab="{{ block.id }}"
          aria-controls="BenefitPanel-{{ section.id }}-{{ block.id }}"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          {{ block.shopify_attributes }}
        >
          {{ block.settings.label | escape }}
        </button>
      {%- endfor -%}
    </div>

    {%- for block in section.blocks -%}
      <div
        class="biothomas-benefits__panel{% if forloop.first %} is-active{% endif %}"
        role="tabpanel"
        id="BenefitPanel-{{ section.id }}-{{ block.id }}"
        data-bt-benefit-panel="{{ block.id }}"
        aria-labelledby="BenefitTab-{{ section.id }}-{{ block.id }}"
      >
        <div>
          <h3 class="biothomas-card__title">{{ block.settings.title | escape }}</h3>
          <p class="biothomas-card__text" style="margin-top: 1rem; font-size: 1.55rem;">
            {{ block.settings.body | escape }}
          </p>
          {%- if block.settings.point_1 != blank or block.settings.point_2 != blank or block.settings.point_3 != blank -%}
            <ul class="biothomas-benefits__list">
              {%- if block.settings.point_1 != blank -%}<li>{{ block.settings.point_1 | escape }}</li>{%- endif -%}
              {%- if block.settings.point_2 != blank -%}<li>{{ block.settings.point_2 | escape }}</li>{%- endif -%}
              {%- if block.settings.point_3 != blank -%}<li>{{ block.settings.point_3 | escape }}</li>{%- endif -%}
            </ul>
          {%- endif -%}
        </div>
        <div class="biothomas-benefits__visual">
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                widths: '600, 900, 1200',
                sizes: '(min-width: 990px) 40vw, 100vw',
                alt: block.settings.image.alt | default: block.settings.title
            }}
          {%- else -%}
            <span>{{ block.settings.caption | default: block.settings.title | escape }}</span>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "BIOThomas Benefits",
  "tag": "section",
  "class": "section-biothomas-benefits",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "System Capabilities"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Explore flow rates, gas profiles, and form factors across the BIOThomas lineup."
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "text", "id": "label", "label": "Tab label", "default": "Daily Use" },
        { "type": "text", "id": "title", "label": "Title", "default": "Built for everyday routines" },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body",
          "default": "H₂-Lite delivers pure molecular hydrogen in a compact form factor sized for personal, at-home, and travel use."
        },
        { "type": "text", "id": "point_1", "label": "Point 1", "default": "Pure H₂ output at 99.99%" },
        { "type": "text", "id": "point_2", "label": "Point 2", "default": "Quiet operation for daily use" },
        { "type": "text", "id": "point_3", "label": "Point 3", "default": "Ideal paired with H₂-Lite travel use" },
        { "type": "text", "id": "caption", "label": "Visual caption", "default": "Portable H₂ for everyday routines" },
        { "type": "image_picker", "id": "image", "label": "Image" }
      ]
    }
  ],
  "presets": [
    {
      "name": "BIOThomas Benefits",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "label": "Daily Use",
            "title": "Built for everyday routines",
            "body": "H₂-Lite delivers pure molecular hydrogen in a compact form factor sized for personal, at-home, and travel use.",
            "point_1": "Pure H₂ output at 99.99%",
            "point_2": "Quiet operation for daily use",
            "point_3": "Ideal paired with H₂-Lite travel use",
            "caption": "Portable H₂ for everyday routines"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "label": "Athletic Use",
            "title": "Higher flow for training environments",
            "body": "OxyHydrogen Pro delivers a hydrogen–oxygen mix at higher flow rates suited to athletic facilities and post-training routines.",
            "point_1": "1200–1800 ml/min Pro flow band",
            "point_2": "Stable output for longer run times",
            "point_3": "Fits evening training schedules",
            "caption": "Train hard. Stay consistent."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "label": "Quiet Home Use",
            "title": "Designed for focused, quiet sessions",
            "body": "BIOThomas systems are engineered for consistent purity and low-noise operation in home and studio settings.",
            "point_1": "Quiet, at-home session design",
            "point_2": "Consistent purity at 99.99%",
            "point_3": "Dual-user Hydro-Max option",
            "caption": "Consistent purity. Quiet design."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "label": "Long-Term Ownership",
            "title": "Built for years of reliable use",
            "body": "BIOThomas platforms are engineered for durable daily operation, with warranty options and dual-user configurations.",
            "point_1": "Extended warranty add-ons",
            "point_2": "Dual-user and shared-environment setups",
            "point_3": "Global free shipping on systems",
            "caption": "Build. Grow. Stay consistent."
          }
        }
      ]
    }
  ]
}
{% endschema %}
