<section class="biothomas-section" id="BiothomasAbout-{{ section.id }}" style="background: #fff;">
  <div class="biothomas-section__inner">
    <div class="biothomas-grid biothomas-grid--2" style="align-items: center;">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="biothomas-hero__eyebrow" style="color: var(--bt-charcoal);">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="biothomas-section__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="biothomas-section__subheading rte">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <div style="margin-top: 2rem;">
            <a
              class="button"
              {% if section.settings.button_link == blank %}
                role="link" aria-disabled="true"
              {% else %}
                href="{{ section.settings.button_link }}"
              {% endif %}
            >
              {{ section.settings.button_label | escape }}
            </a>
          </div>
        {%- endif -%}
      </div>
      <div class="biothomas-card__media" style="min-height: 32rem; border-radius: var(--bt-radius-lg);">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1400
            | image_tag:
              loading: 'lazy',
              widths: '600, 900, 1200, 1400',
              sizes: '(min-width: 750px) 45vw, 100vw',
              alt: section.settings.image.alt | default: section.settings.heading
          }}
        {%- else -%}
          <span>{% comment %} TODO: Replace with About BIOThomas imagery {% endcomment %}About BIOThomas</span>
        {%- endif -%}
      </div>
    </div>
    {%- if section.settings.show_disclaimer -%}
      <p class="biothomas-disclaimer">
        {{ section.settings.disclaimer | default: 'BIOThomas systems are consumer/professional equipment. Follow the product manual. This site does not provide medical advice.' | escape }}
      </p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "BIOThomas About",
  "tag": "section",
  "class": "section-biothomas-about",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "About BIOThomas"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Precision hydrogen systems for modern daily use"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>TODO: Replace with client-approved BIOThomas story. We design professional-grade molecular hydrogen and oxyhydrogen platforms for daily use, athletic use, and professional environments.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Our story"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "show_disclaimer",
      "label": "Show product disclaimer",
      "default": true
    },
    {
      "type": "textarea",
      "id": "disclaimer",
      "label": "Disclaimer text",
      "default": "BIOThomas systems are consumer/professional equipment. Follow the product manual. This site does not provide medical advice."
    }
  ],
  "presets": [
    {
      "name": "BIOThomas About"
    }
  ]
}
{% endschema %}
