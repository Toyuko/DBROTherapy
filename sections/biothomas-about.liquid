<section class="biothomas-section" id="BiothomasAbout-{{ section.id }}" style="background: #fff;">
  <div class="biothomas-section__inner">
    <div class="biothomas-grid biothomas-grid--2{% unless section.settings.show_media %} biothomas-about--text-only{% endunless %}" style="align-items: center;">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="biothomas-hero__eyebrow" style="color: var(--bt-charcoal);">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="biothomas-section__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="biothomas-section__subheading rte">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <div style="margin-top: 2rem;">
            <a
              class="button"
              {% if section.settings.button_link == blank %}
                role="link" aria-disabled="true"
              {% else %}
                href="{{ section.settings.button_link }}"
              {% endif %}
            >
              {{ section.settings.button_label | escape }}
            </a>
          </div>
        {%- endif -%}
      </div>
      {%- if section.settings.show_media -%}
        <div class="biothomas-about__media">
          {%- if section.settings.video != blank -%}
            {{
              section.settings.video
              | video_tag:
                autoplay: true,
                loop: true,
                muted: true,
                controls: false,
                playsinline: true,
                image_size: '1400x'
            }}
          {%- elsif section.settings.image != blank -%}
            {{
              section.settings.image
              | image_url: width: 1400
              | image_tag:
                loading: 'lazy',
                widths: '600, 900, 1200, 1400',
                sizes: '(min-width: 750px) 45vw, 100vw',
                alt: section.settings.image.alt | default: section.settings.heading
            }}
          {%- else -%}
            <video
              class="biothomas-about__video"
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              aria-label="{{ section.settings.heading | default: 'BIOTHOMAS' | escape }}"
            >
              <source src="{{ 'biothomas-about.mp4' | asset_url }}" type="video/mp4">
            </video>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
    {%- if section.settings.show_disclaimer -%}
      <p class="biothomas-disclaimer">
        {{ section.settings.disclaimer | default: 'BIOTHOMAS systems are consumer/professional equipment. Follow the product manual. This site does not provide medical advice.' | escape }}
      </p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "BIOTHOMAS About",
  "tag": "section",
  "class": "section-biothomas-about",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "About BIOTHOMAS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Precision hydrogen systems for modern daily use"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>TODO: Replace with client-approved BIOTHOMAS story. We design professional-grade molecular hydrogen and oxyhydrogen platforms for daily use, athletic use, and professional environments.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_media",
      "label": "Show media beside text",
      "default": true
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video (Shopify-hosted)",
      "info": "Optional. If empty, the theme asset biothomas-about.mp4 is used."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Used when no video is selected and the theme asset is unavailable."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Our story"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "show_disclaimer",
      "label": "Show product disclaimer",
      "default": true
    },
    {
      "type": "textarea",
      "id": "disclaimer",
      "label": "Disclaimer text",
      "default": "BIOTHOMAS systems are consumer/professional equipment. Follow the product manual. This site does not provide medical advice."
    }
  ],
  "presets": [
    {
      "name": "BIOTHOMAS About"
    }
  ]
}
{% endschema %}
