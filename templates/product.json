{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": false
          }
        },
        "description": {
          "type": "description"
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "price",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "description",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "thumbnail",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "show",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "biothomas_product_details": {
      "type": "biothomas-product-details",
      "blocks": {
        "ship": {
          "type": "accordion",
          "settings": {
            "title": "Shipping information",
            "content": "<p>TODO: Confirm shipping regions, lead times, and duties. Systems typically ship with free delivery where offered.</p>"
          }
        },
        "returns": {
          "type": "accordion",
          "settings": {
            "title": "Returns information",
            "content": "<p>TODO: Replace with client-approved refund policy summary and link to full policy page.</p>"
          }
        },
        "warranty": {
          "type": "accordion",
          "settings": {
            "title": "Warranty",
            "content": "<p>Each machine includes a 1-year warranty. Extended coverage options can be offered as product variants or add-ons.</p>"
          }
        },
        "safety": {
          "type": "accordion",
          "settings": {
            "title": "Safety & disclaimer",
            "content": "<p>TODO: BIOTHOMAS systems are consumer/professional equipment. Follow the product manual. This site does not provide medical advice.</p>"
          }
        }
      },
      "block_order": ["ship", "returns", "warranty", "safety"],
      "settings": {
        "heading": "Product highlights",
        "show_review_placeholder": true
      }
    },
    "disclosures": {
      "type": "disclosures",
      "settings": {
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "Related products",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    },
    "biothomas_recently_viewed": {
      "type": "biothomas-recently-viewed",
      "settings": {
        "heading": "Recently viewed",
        "text": "Your recently viewed BIOTHOMAS products will appear here as you browse."
      }
    }
  },
  "order": [
    "main",
    "biothomas_product_details",
    "disclosures",
    "related-products",
    "biothomas_recently_viewed"
  ]
}
