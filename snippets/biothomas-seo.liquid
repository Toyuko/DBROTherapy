{% comment %}
  BIOThomas JSON-LD: Organization, BreadcrumbList, Product, FAQPage (when applicable).
{% endcomment %}

{%- liquid
  assign org_name = shop.name | default: 'BIOThomas'
  assign org_url = request.origin
  assign org_logo = settings.logo | default: blank
-%}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": {{ org_name | json }},
    "url": {{ org_url | json }},
    "description": {{ shop.description | default: 'Advanced molecular hydrogen and oxyhydrogen systems for wellness, recovery, and professional care.' | json }}
    {%- if org_logo != blank -%}
    ,"logo": {{ org_logo | image_url: width: 600 | prepend: 'https:' | json }}
    {%- endif -%}
    {%- if settings.social_instagram_link != blank or settings.social_youtube_link != blank or settings.social_facebook_link != blank -%}
    ,"sameAs": [
      {%- assign same_as = '' -%}
      {%- if settings.social_instagram_link != blank -%}{%- assign same_as = same_as | append: settings.social_instagram_link | append: '||' -%}{%- endif -%}
      {%- if settings.social_youtube_link != blank -%}{%- assign same_as = same_as | append: settings.social_youtube_link | append: '||' -%}{%- endif -%}
      {%- if settings.social_facebook_link != blank -%}{%- assign same_as = same_as | append: settings.social_facebook_link | append: '||' -%}{%- endif -%}
      {%- if settings.social_twitter_link != blank -%}{%- assign same_as = same_as | append: settings.social_twitter_link | append: '||' -%}{%- endif -%}
      {%- assign same_as_array = same_as | split: '||' -%}
      {%- for url in same_as_array -%}
        {%- if url != blank -%}{{ url | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endif -%}
      {%- endfor -%}
    ]
    {%- endif -%}
  }
</script>

{%- if template.name != 'index' and template.name != 'cart' and template.name != 'customers/login' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": {{ request.origin | json }}
        }
        {%- if collection -%}
        ,{
          "@type": "ListItem",
          "position": 2,
          "name": {{ collection.title | json }},
          "item": {{ request.origin | append: collection.url | json }}
        }
        {%- endif -%}
        {%- if product -%}
        {%- if collection -%}
        ,{
          "@type": "ListItem",
          "position": 3,
          "name": {{ product.title | json }},
          "item": {{ request.origin | append: product.url | json }}
        }
        {%- else -%}
        ,{
          "@type": "ListItem",
          "position": 2,
          "name": {{ product.title | json }},
          "item": {{ request.origin | append: product.url | json }}
        }
        {%- endif -%}
        {%- endif -%}
        {%- if article -%}
        ,{
          "@type": "ListItem",
          "position": 2,
          "name": {{ blog.title | json }},
          "item": {{ request.origin | append: blog.url | json }}
        }
        ,{
          "@type": "ListItem",
          "position": 3,
          "name": {{ article.title | json }},
          "item": {{ request.origin | append: article.url | json }}
        }
        {%- endif -%}
        {%- if page and template.name == 'page' -%}
        ,{
          "@type": "ListItem",
          "position": 2,
          "name": {{ page.title | json }},
          "item": {{ request.origin | append: page.url | json }}
        }
        {%- endif -%}
      ]
    }
  </script>
{%- endif -%}

{%- if request.page_type == 'product' and product -%}
  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>
{%- endif -%}
